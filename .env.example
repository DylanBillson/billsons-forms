# Production identity and cryptographic material. Generate values; never commit .env.
APP_NAME="Billson's Forms"
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=replace-with-at-least-32-random-characters
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
BASE_URL=https://forms.example.com
DEFAULT_TIMEZONE=Europe/London
SECURE_COOKIES=true
SESSION_LIFETIME_HOURS=336

POSTGRES_DB=billsons_forms
POSTGRES_USER=billsons_forms
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql+psycopg://billsons_forms:replace-with-a-long-random-database-password@db:5432/billsons_forms

# REQUIRED: set this to the actual external Docker edge-network subnet (or explicit Traefik IP).
# Discover it with: docker network inspect edge --format '{{(index .IPAM.Config 0).Subnet}}'
# Broad Docker/private ranges are rejected in production.
TRUSTED_PROXIES=
TRAEFIK_HOST=forms.example.com
IMAGE_TAG=latest
ABSOLUTE_MAX_PAYLOAD_KB=1024
ABSOLUTE_MAX_PAYLOAD_BYTES=1048576

LOGIN_RATE_LIMIT_REQUESTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
DEFAULT_FORM_RATE_LIMIT_REQUESTS=30
DEFAULT_FORM_RATE_LIMIT_WINDOW_SECONDS=60
SMTP_TIMEOUT_SECONDS=20

DELIVERY_LOG_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=730
EXPIRED_SESSION_RETENTION_DAYS=30
RATE_LIMIT_RETENTION_HOURS=0
QUEUE_TERMINAL_RETENTION_DAYS=7
CLEANUP_INTERVAL_SECONDS=3600
QUEUE_MAX_ATTEMPTS=6
QUEUE_POLL_SECONDS=2
QUEUE_LOCK_TIMEOUT_SECONDS=300
QUEUE_HEARTBEAT_SECONDS=60
